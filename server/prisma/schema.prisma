datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
}

enum GroupDay {
  DUSH
  SESH
  CHOR
  PAY
  JU
  SHAN
  YAK
}

enum GroupStatus {
  FAOL
  TUGAGAN
  TO_XTATILGAN
}

enum TeacherSalaryType {
  FIXED
  PERCENT
}

enum ActiveStatus {
  FAOL
  NOFAOL
}

enum StudentGender {
  ERKAK
  AYOL
}

enum StudentStatus {
  FAOL
  BITIRGAN
  CHIQIB_KETGAN
}

enum AttendanceStatus {
  KELGAN
  KELMAGAN
  KECHIKKAN
}

enum PaymentMethod {
  NAQD
  KARTA
  OTKAZMA
}

enum PaymentStatus {
  TOLANGAN
  TOLANMAGAN
  QISMAN
}

enum ExpenseType {
  USTOZ_MAOSHI
  IJARA
  KOMMUNAL
  REKLAMA
  BOSHQA
}

enum ExpenseStatus {
  KUTILMOQDA
  TOLANGAN
}

model Center {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  password     String
  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users         User[]
  courses       Course[]
  groups        Group[]
  teachers      Teacher[]
  students      Student[]
  rooms         Room[]
  employees     Employee[]
  payments      Payment[]
  expenses      Expense[]
  attendances   Attendance[]
  studentGroups StudentGroup[]
  certificates  Certificate[]

  @@map("centers")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivedPayments Payment[] @relation("ReceivedPayments")

  @@map("users")
}

model Course {
  id          String   @id @default(uuid())
  name        String
  price       Float
  description String?
  isActive    Boolean  @default(true)
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups       Group[]
  payments     Payment[]
  certificates Certificate[]

  @@map("courses")
}

model Room {
  id        String   @id @default(uuid())
  name      String
  floor     Int
  number    String
  capacity  Int
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups Group[]

  @@map("rooms")
}

model Teacher {
  id             String            @id @default(uuid())
  firstName      String
  lastName       String
  phone          String
  passportSeries String?
  salaryType     TeacherSalaryType @default(FIXED)
  salaryValue    Float
  status         ActiveStatus      @default(FAOL)
  centerId       String
  center         Center            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  groups Group[]

  @@map("teachers")
}

model Group {
  id        String      @id @default(uuid())
  name      String
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  days      GroupDay[]
  startTime String
  endTime   String
  status    GroupStatus @default(FAOL)
  startDate DateTime
  centerId  String
  center    Center      @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  studentGroups StudentGroup[]
  attendances   Attendance[]
  payments      Payment[]

  @@map("groups")
}

model Student {
  id              String        @id @default(uuid())
  firstName       String
  lastName        String
  birthDate       DateTime
  phone           String
  fatherPhone     String?
  motherPhone     String?
  passportSeries  String?
  gender          StudentGender
  isSchoolStudent Boolean       @default(false)
  status          StudentStatus @default(FAOL)
  centerId        String
  center          Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  studentGroups StudentGroup[]
  attendances   Attendance[]
  payments      Payment[]
  certificates  Certificate[]

  @@map("students")
}

model StudentGroup {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, groupId])
  @@map("student_groups")
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus
  note      String?
  centerId  String
  center    Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, groupId, date])
  @@map("attendances")
}

model Employee {
  id        String       @id @default(uuid())
  firstName String
  lastName  String
  phone     String
  position  String
  salary    Float
  hiredAt   DateTime     @default(now())
  status    ActiveStatus @default(FAOL)
  centerId  String
  center    Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("employees")
}

model Payment {
  id           String        @id @default(uuid())
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  courseId     String?
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  amount       Float
  paymentDate  DateTime      @default(now())
  method       PaymentMethod @default(NAQD)
  status       PaymentStatus @default(TOLANGAN)
  receivedById String?
  receivedBy   User?         @relation("ReceivedPayments", fields: [receivedById], references: [id], onDelete: SetNull)
  centerId     String
  center       Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("payments")
}

model Expense {
  id        String        @id @default(uuid())
  date      DateTime      @default(now())
  amount    Float
  type      ExpenseType
  ownerName String?
  status    ExpenseStatus @default(TOLANGAN)
  note      String?
  centerId  String
  center    Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("expenses")
}

model Certificate {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt     DateTime @default(now())
  serialNumber String
  centerId     String
  center       Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([centerId, serialNumber])
  @@map("certificates")
}
