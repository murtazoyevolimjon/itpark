# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Sessions: long random values (>= 32 chars). The app refuses to sign tokens in production without them.
JWT_SECRET="change-me-to-a-long-random-string"
SUPERADMIN_JWT_SECRET="change-me-to-another-long-random-string"

# Developer (superadmin) account. Both must be set, otherwise env-based superadmin login is disabled.
SUPERADMIN_LOGIN=""
SUPERADMIN_PASSWORD=""

# Telegram bot (BotFather token) and the secret Telegram sends back with every webhook call
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# Optional
# ALLOW_PUBLIC_REGISTRATION=true   # open self-registration of centers (default: closed, developer creates centers)
# GEMINI_API_KEY=""
